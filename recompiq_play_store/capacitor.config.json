{
  "appId": "com.recompiq.app",
  "appName": "RecompIQ",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "keystorePath": "recompiq-release-key.jks",
      "keystoreAlias": "recompiq",
      "releaseType": "AAB"
    },
    "backgroundColor": "#09090b"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#09090b",
      "overlaysWebView": false
    }
  }
}